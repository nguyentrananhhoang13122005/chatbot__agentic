# === UniSearch AI — Environment Variables ===
# Copy file này thành .env và điền API key thật



GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/callback"

# Auth
# Generate a long random value for local/dev, and use a secret manager in production.
JWT_SECRET="replace-with-a-long-random-secret"
SECURE_COOKIE="false"

# Frontend/backend URLs
NEXT_PUBLIC_API_URL="http://localhost:8000"
# Groq API (backup, optional)
# GROQ_API_KEY="gsk_your-groq-key-here"

# --- LLM (llm_client.py) ---
# Danh sách model theo thứ tự ưu tiên, phân tách bằng dấu phẩy. Model free thường bị 429 nên đặt cuối.
LLM_MODELS="qwen/qwen3.7-flash,qwen/qwen3.7-plus,google/gemma-4-31b-it:free"
LLM_TIMEOUT=45
LLM_MAX_RETRIES=1
# Tắt chế độ "thinking" để giảm độ trễ (tuyển sinh là tra cứu, không cần suy luận dài)
LLM_DISABLE_REASONING=true

# --- Guardrails (utils/guardrails.py) ---
MAX_QUERY_CHARS=1000
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Server ---
LOG_LEVEL=INFO
# CORS_EXTRA_ORIGINS=http://127.0.0.1:3000