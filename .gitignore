# ============================================================
# .gitignore — BẢO MẬT DỮ LIỆU TUYỆT ĐỐI
# Chỉ đẩy CODE lên GitHub, KHÔNG đẩy dữ liệu nhạy cảm
# ============================================================

# === DATA & DATABASE (THÔNG TIN BẢO MẬT — TUYỆT ĐỐI KHÔNG PUSH) ===
data/*.csv
data/*.xlsx
data/*.pdf
data/*.json
data/*.db
data/1.*/
data/2.*/
data/3.*/
data/4.*/
data/5.*/
!data/data_mock.csv

# Vector Database (chứa embeddings dữ liệu nhạy cảm)
vector_db_tuyensinh/

# OCR Tessdata models (file nặng, không cần push)
tessdata/

# === ENVIRONMENTS & SECRETS (API KEYS, TOKENS) ===
.env
.env.local
.env.*
!.env.example

# === AGENT CONFIG (chứa skills nội bộ) ===
.agents/
skills-lock.json
SKILL.md

# === DEBUG & TEMP FILES ===
debug_*.jpg
debug_*.png
/test_*.py
!tests/
!tests/**

# === PYTHON ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# === VIRTUAL ENVIRONMENTS ===
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# === NODE.JS (next-app) ===
node_modules/
next-app/node_modules/
next-app/.next/
.next/

# === OS GENERATED FILES ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
